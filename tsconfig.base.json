{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": false,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true
	}
}
